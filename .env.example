# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Microsoft Entra App Registration -> Application (client) ID
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Usually "common" for a desktop app that should support personal/work accounts.
MICROSOFT_TENANT_ID=common

# Gemini model used for classification
GEMINI_MODEL=gemini-2.5-flash

# Number of recent inbox messages to inspect per run
EMAIL_LIMIT=25
